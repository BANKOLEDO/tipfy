{
  "name": "tipfy-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" tsx src/index.ts",
    "test": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" vitest run",
    "db:generate": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" prisma generate",
    "db:migrate": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" prisma migrate dev",
    "db:push": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" prisma db push",
    "db:seed": "cross-env NODE_OPTIONS=\"--dns-result-order=ipv4first\" tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jose": "^5.9.0",
    "morgan": "^1.10.0",
    "resend": "^6.18.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "vitest-tsconfig-paths": "^3.4.1"
  }
}
