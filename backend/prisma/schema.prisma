generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
// CORE MODELS

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String   @map("password_hash")
  username          String   @unique
  displayName       String   @map("display_name")
  avatarUrl         String?  @map("avatar_url")
  bio               String?
  location          String?
  isBusiness        Boolean  @default(false) @map("is_business")
  businessName      String?  @map("business_name")
  businessCategory  String?  @map("business_category")
  totalTipsReceived Int      @default(0) @map("total_tips_received")
  totalAmount       Decimal  @default(0) @db.Decimal(18, 2) @map("total_amount")
  rating            Decimal  @default(0) @db.Decimal(3, 2)
  withdrawalPinHash String?  @map("withdrawal_pin_hash")
  isVerified        Boolean  @default(false) @map("is_verified")
  isActive          Boolean  @default(true) @map("is_active")
  role              String   @default("user")
  plan              String   @default("free")
  planExpiresAt     DateTime? @map("plan_expires_at")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sentTips        Tip[]             @relation("Sender")
  receivedTips    Tip[]             @relation("Recipient")
  withdrawals     Withdrawal[]
  teamMemberships Team[]            @relation("MemberTeam")
  businessTeams   Team[]            @relation("BusinessTeam")
  feedbackGiven   Feedback[]        @relation("FeedbackSender")
  feedbackReceived Feedback[]       @relation("FeedbackRecipient")
  notifications   Notification[]
  auditLogs       AuditLog[]
  sessions        Session[]
  passwordResetTokens PasswordResetToken[]
  otps            Otp[]
  ledgerEntries   LedgerEntry[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  otpHash   String   @map("otp_hash")
  purpose   String   @default("withdrawal_pin")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otpHash])
  @@map("otps")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Tip {
  id               String   @id @default(cuid())
  reference        String   @unique
  senderId         String?  @map("sender_id")
  senderName       String?  @map("sender_name")
  recipientId      String   @map("recipient_id")
  amount           Decimal  @db.Decimal(18, 2)
  platformFee      Decimal  @default(0) @db.Decimal(18, 2) @map("platform_fee")
  processingFee    Decimal  @default(0) @db.Decimal(18, 2) @map("processing_fee")
  netAmount        Decimal  @default(0) @db.Decimal(18, 2) @map("net_amount")
  totalCharged     Decimal  @default(0) @db.Decimal(18, 2) @map("total_charged")
  currency         String   @default("NGN")
  message          String?
  category         String   @default("general")
  isAnonymous      Boolean  @default(false) @map("is_anonymous")
  status           String   @default("pending")
  monnifyReference String?  @map("monnify_reference")
  paymentMethod    String?  @map("payment_method")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sender      User?        @relation("Sender", fields: [senderId], references: [id])
  recipient   User         @relation("Recipient", fields: [recipientId], references: [id])
  transaction Transaction?
  feedback    Feedback?
  ledgerEntries LedgerEntry[]

  @@index([recipientId])
  @@index([senderId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@map("tips")
}

model Transaction {
  id              String   @id @default(cuid())
  tipId           String   @unique @map("tip_id")
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @default("NGN")
  paymentMethod   String   @map("payment_method")
  monnifyResponse Json     @map("monnify_response")
  status          String   @default("pending")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  tip Tip @relation(fields: [tipId], references: [id])

  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Money journal.
//
// Every balance change appends rows here in the same transaction that moves the
// balance. Without it a duplicate credit is invisible: there was no record to
// reconcile against, so a correct balance could not be told from a wrong one.
//
// Invariant: the legs of one entryGroupId sum to zero. Debit moves value out,
// credit moves it in, and userId is null for the platform's own accounts.
// The reconciliation job re-checks every group, so a bad write is found even if
// the code that made it is long gone.
// ---------------------------------------------------------------------------

enum LedgerAccount {
  // Customer-facing
  USER_AVAILABLE
  // Assets held on behalf of the business until paid out
  WITHDRAWAL_PENDING
  // Owed to the payment provider
  MONNIFY_RECEIVABLE
  // Already handed to the provider, awaiting settlement
  MONNIFY_PAYABLE
  // Platform revenue
  PLATFORM_FEE_REVENUE
  WITHDRAWAL_FEE_REVENUE
  // Withheld but not yet remitted to the tax authority
  TAX_PAYABLE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id           String          @id @default(cuid())
  entryGroupId String          @map("entry_group_id")
  account      LedgerAccount
  direction    LedgerDirection
  amount       Decimal         @db.Decimal(18, 2)
  // Running balance for USER_AVAILABLE entries, so a single row can be
  // checked against the user's balance without summing the whole history.
  balanceAfter Decimal?        @db.Decimal(18, 2) @map("balance_after")
  entryType    String          @map("entry_type")
  // Null for platform accounts.
  userId       String?         @map("user_id")
  tipId        String?         @map("tip_id")
  withdrawalId String?         @map("withdrawal_id")
  reference    String
  note         String?
  createdAt    DateTime        @default(now()) @map("created_at")

  // Restrict, not SetNull: cascading a delete would unlink ledger lines from
  // the user, tip or withdrawal they describe. Matches tips.recipient_id,
  // which is already Restrict.
  //
  // So a row with ledger history cannot be hard-deleted. Use anonymisation
  // instead, and have test fixtures TRUNCATE, which bypasses row triggers.
  user       User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tip        Tip?       @relation(fields: [tipId], references: [id], onDelete: Restrict)
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([entryGroupId])
  @@index([entryGroupId, account])
  @@index([userId, createdAt])
  @@index([reference])
  @@index([entryType])
  @@map("ledger_entries")
}

// Relays a retried request to its first response instead of charging or
// paying out twice. Written in the same transaction as the operation.
model IdempotencyKey {
  id             String    @id @default(cuid())
  scope          String
  key            String
  userId         String?   @map("user_id")
  // SHA-256 of the request body. Reusing a key with a different payload is a
  // client bug and is rejected rather than silently returning the old answer.
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  user User? @relation(fields: [userId], references: [id])

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// Monnify retries a webhook until it gets a 2xx, so the same event legitimately
// arrives many times. The unique constraint is what makes handling it twice
// impossible at the storage layer rather than by careful coding.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  provider    String   @default("monnify")
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  payloadHash String   @map("payload_hash")
  status      String   @default("processed")
  error       String?
  receivedAt  DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("processed_webhook_events")
}

model ReconciliationRun {
  id               String    @id @default(cuid())
  runType          String    @map("run_type")
  status           String    @default("running")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  checkedCount     Int       @default(0) @map("checked_count")
  discrepancyCount Int       @default(0) @map("discrepancy_count")
  summary          Json?
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([runType, startedAt])
  @@map("reconciliation_runs")
}

model Withdrawal {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  amount          Decimal  @db.Decimal(18, 2)
  fee             Decimal  @default(0) @db.Decimal(18, 2)
  netAmount       Decimal  @default(0) @db.Decimal(18, 2) @map("net_amount")
  estimatedTax    Decimal  @default(0) @db.Decimal(18, 2) @map("estimated_tax")
  bankCode        String   @map("bank_code")
  bankName        String   @map("bank_name")
  // Superseded by accountNumberEncrypted, and nullable so new rows can leave
  // it NULL instead of writing plaintext. backfillAccountNumbers.ts encrypts
  // the legacy values and then sets this to NULL; readAccountNumber() in
  // lib/crypto.ts handles both states.
  accountNumber   String?  @map("account_number")
  accountNumberEncrypted String? @map("account_number_encrypted")
  accountNumberLast4     String? @map("account_number_last4")
  accountNumberHash      String? @map("account_number_hash")
  accountName     String   @map("account_name")
  reference       String   @unique
  status          String   @default("pending")
  monnifyResponse Json?    @map("monnify_response")
    processedAt     DateTime? @map("processed_at")
    failureReason   String?  @map("failure_reason")
    createdAt       DateTime @default(now()) @map("created_at")
    updatedAt       DateTime @default(now()) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([accountNumberHash])
  @@map("withdrawals")
}

model Team {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  memberId    String   @map("member_id")
  role        String   @default("staff")
  tipsReceived Int     @default(0) @map("tips_received")
  totalAmount Decimal  @default(0) @db.Decimal(18, 2) @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  business User @relation("BusinessTeam", fields: [businessId], references: [id])
  member   User @relation("MemberTeam", fields: [memberId], references: [id])

  @@unique([businessId, memberId])
  @@map("teams")
}

model Feedback {
  id          String   @id @default(cuid())
  tipId       String   @unique @map("tip_id")
  senderId    String?  @map("sender_id")
  recipientId String   @map("recipient_id")
  rating      Int      @db.SmallInt
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  tip       Tip   @relation(fields: [tipId], references: [id])
  sender    User? @relation("FeedbackSender", fields: [senderId], references: [id])
  recipient User  @relation("FeedbackRecipient", fields: [recipientId], references: [id])

  @@index([recipientId])
  @@map("feedbacks")
}


// SECURITY & COMPLIANCE

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  action      String
  resource    String
  resourceId  String?  @map("resource_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@index([key, expiresAt])
  @@map("rate_limits")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
