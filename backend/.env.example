# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tipfy"

# Auth
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# CORS
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Monnify
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WEBHOOK_SECRET=""
# Your WALLET ACCOUNT NUMBER from the Monnify dashboard → Disbursements page
MONNIFY_WALLET_ACCOUNT_NUMBER=""
# Comma-separated checkout allowlist. CARD can carry international cards (4% MDR) —
# set to ACCOUNT_TRANSFER,USSD for zero international exposure.
MONNIFY_PAYMENT_METHODS="CARD,ACCOUNT_TRANSFER,USSD"

# Fees & Monetization
PLATFORM_FEE_PERCENT=5
PRO_PLATFORM_FEE_PERCENT=3
PROCESSING_FEE_MARKUP=50
FREE_WITHDRAWALS_PER_MONTH=3
WITHDRAWAL_FEE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TIP_RATE_LIMIT_MAX=20

# Encryption (for sensitive data like BVN)
# Must be hex: ENCRYPTION_KEY = 32 bytes (64 hex chars), ENCRYPTION_IV = 16 bytes (32 hex chars)
ENCRYPTION_KEY="00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
ENCRYPTION_IV="00112233445566778899aabbccddeeff"

# Email (optional)
RESEND_API_KEY=""

# Admin auto-promotion (optional) 
# grants the admin role. Keep it empty in production unless intended.
ADMIN_EMAIL=""

# Logging
LOG_LEVEL="dev"
